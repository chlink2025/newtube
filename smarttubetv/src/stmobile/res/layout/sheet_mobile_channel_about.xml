<?xml version="1.0" encoding="utf-8"?>
<!--
  NEWTUBE(channel-about): the channel author's About sheet, mirroring the official
  channel_about_metadata_item (description, joined/country/subscribers/videos/views, links) plus
  the artist biography. Filled by ChannelAboutSheet; lazily loaded when "...more" is tapped.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mobile_sheet"
    android:orientation="vertical">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_mobile_sheet_handle" />

    <TextView
        android:id="@+id/mobile_channel_about_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Marques Brownlee" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/mobile_color_divider" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <ProgressBar
                android:id="@+id/mobile_channel_about_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/mobile_color_primary"
                android:indeterminateTintMode="src_in"
                android:visibility="gone" />

            <TextView
                android:id="@+id/mobile_channel_about_description_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mobile_channel_about_description"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mobile_channel_about_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textSize="14sp"
                tools:text="MKBHD: Quality Tech Videos | YouTuber | Consumer Electronics | Tech Head" />

            <TextView
                android:id="@+id/mobile_channel_about_artist_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/mobile_channel_about_biography"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/mobile_channel_about_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/mobile_channel_about_info_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/mobile_channel_about_links_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/mobile_channel_about_links"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/mobile_channel_about_links"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
