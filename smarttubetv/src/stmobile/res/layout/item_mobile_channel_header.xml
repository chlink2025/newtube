<?xml version="1.0" encoding="utf-8"?>
<!--
  NEWTUBE(channel-about): the channel author's About block as the first row of the channel grid.
  Avatar + name + handle/subscribers, the (collapsed) bio and a "...more" that opens the full
  About sheet. Scrolled away with the feed, like the official channel page header.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_channel_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mobile_channel_header_avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_watch_channel_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mobile_channel_header_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Marques Brownlee" />

            <TextView
                android:id="@+id/mobile_channel_header_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textSize="13sp"
                tools:text="@mkbhd • 21.3M subscribers" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/mobile_channel_header_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/mobile_color_on_surface_secondary"
        android:textSize="14sp"
        tools:text="MKBHD: Quality Tech Videos | YouTuber | Consumer Electronics | Tech Head" />

    <TextView
        android:id="@+id/mobile_channel_header_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingVertical="4dp"
        android:text="@string/mobile_channel_about_more"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
